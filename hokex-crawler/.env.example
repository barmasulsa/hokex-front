# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Crawler Configuration
CRAWL_SCHEDULE=0 6 1 * *  # Monthly at 6 AM on the 1st
MAX_PARALLEL_JOBS=3
CRAWL_TIMEOUT_MINUTES=30
RETRY_MAX_ATTEMPTS=3

# Image Processing
ENABLE_IMAGE_DOWNLOAD=false
IMAGE_PLACEHOLDER_URL=https://via.placeholder.com/400x300

# Notifications
ADMIN_EMAIL=admin@hokex.com
SLACK_WEBHOOK_URL=

# Logging
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# Server
PORT=3001
NODE_ENV=development
