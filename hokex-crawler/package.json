{
  "name": "hokex-crawler",
  "version": "1.0.0",
  "description": "HOKEX Event Data Crawler - Automatically collects event data from 22 Korean venues",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test-server": "tsx src/test-server.ts",
    "inspect-coex": "tsx src/scripts/inspect-coex.ts",
    "load-coex": "tsx src/scripts/load-coex-data.ts",
    "auto-crawl-coex": "tsx src/scripts/auto-crawl-coex.ts",
    "auto-crawl-setec": "tsx src/scripts/auto-crawl-setec.ts",
    "auto-crawl-magok": "tsx src/scripts/auto-crawl-magok.ts",
    "auto-crawl-all": "tsx src/scripts/auto-crawl-all.ts",
    "load-venue": "tsx src/scripts/load-all-venues.ts",
    "load-all": "tsx src/scripts/load-all-venues.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "crawler",
    "events",
    "hokex",
    "mice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/puppeteer": "^5.4.7",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "puppeteer": "^24.42.0",
    "sharp": "^0.34.5",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
